{{- printf "<?xml version=\"1.0\" encoding=\"UTF-8\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{{- range where (sort site.Pages "RelPermalink") "Params.noindex" "!=" true }}
  <url><loc>{{ strings.TrimSuffix "/" site.BaseURL }}{{ partial "path.html" . }}</loc>{{ if not .Lastmod.IsZero }}<lastmod>{{ .Lastmod.Format "2006-01-02" }}</lastmod>{{ end }}</url>
{{- end }}
</urlset>
